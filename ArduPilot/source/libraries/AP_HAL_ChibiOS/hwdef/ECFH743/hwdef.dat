# ECF Core H743. Board ID is local and is not an upstream allocation.
MCU STM32H7xx STM32H743xx
APJ_BOARD_ID 65001
ENABLE_DFU_BOOT 1
OSCILLATOR_HZ 8000000
FLASH_SIZE_KB 2048
FLASH_RESERVE_START_KB 128
STM32_ST_USE_TIMER 5
define CH_CFG_ST_RESOLUTION 32
define HAL_STORAGE_SIZE 32768
STORAGE_FLASH_PAGE 14
DEFAULTGPIO INPUT FLOATING
define AP_BOOTLOADER_FLASHING_ENABLED 0
define HAL_ECF_SHARED_INTERFACES 1
# Keep GPS1 on physical UART6 even though UART4 has a lower serial index.
define HAL_ECF_GPS_PORT_ORDER 6,4,0,1,2,3,5,7,8

USB_STRING_MANUFACTURER "ECF"
USB_STRING_PRODUCT "ECF H743"
define HAL_USB_RECONNECT_DELAY_MS 1000
define HAL_USB_CONNECT_AFTER_SETUP 1
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1
PA15 VBUS INPUT FLOATING
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

SERIAL_ORDER OTG1 USART1 EMPTY USART3 UART4 UART5 USART6 UART7 UART8
PA9 USART1_TX USART1
PA10 USART1_RX USART1
PD1 UART4_TX UART4
PD0 UART4_RX UART4
PB13 UART5_TX UART5
PB12 UART5_RX UART5
PC6 USART6_TX USART6
PC7 USART6_RX USART6
PE8 UART7_TX UART7
PE7 UART7_RX UART7
define DEFAULT_SERIAL1_PROTOCOL SerialProtocol_RCIN
define DEFAULT_SERIAL2_PROTOCOL SerialProtocol_None
define DEFAULT_SERIAL3_PROTOCOL SerialProtocol_None
define DEFAULT_SERIAL4_PROTOCOL SerialProtocol_GPS
define DEFAULT_SERIAL5_PROTOCOL SerialProtocol_MAVLink2
define DEFAULT_SERIAL6_PROTOCOL SerialProtocol_GPS
define DEFAULT_SERIAL7_PROTOCOL SerialProtocol_ESCTelemetry
define DEFAULT_SERIAL8_PROTOCOL SerialProtocol_None

# BRD_ALT_CONFIG: 0=I2C4/ADC, 1=UART3/ADC, 2=I2C4/UART8, 3=UART3/UART8.
PD8 SHARED_U3_TX INPUT FLOATING
PD9 SHARED_U3_RX INPUT FLOATING
PE0 SHARED_U8_RX INPUT FLOATING
PE1 SHARED_U8_TX INPUT FLOATING
PD8 USART3_TX USART3 ALT(1)
PD9 USART3_RX USART3 ALT(1)
PD12 SHARED_I4_SCL INPUT FLOATING ALT(1)
PD13 SHARED_I4_SDA INPUT FLOATING ALT(1)
PE1 UART8_TX UART8 ALT(2)
PE0 UART8_RX UART8 ALT(2)
PD8 USART3_TX USART3 ALT(3)
PD9 USART3_RX USART3 ALT(3)
PD12 SHARED_I4_SCL INPUT FLOATING ALT(3)
PD13 SHARED_I4_SDA INPUT FLOATING ALT(3)
PE1 UART8_TX UART8 ALT(3)
PE0 UART8_RX UART8 ALT(3)

PA5 SPI1_SCK SPI1
PA6 SPI1_MISO SPI1
PA7 SPI1_MOSI SPI1
PA4 IMU_CS CS
PC3 IMU_INT INPUT FLOATING
SPIDEV icm45686 SPI1 DEVID1 IMU_CS MODE3 2*MHZ 8*MHZ
IMU Invensensev3 SPI:icm45686 ROTATION_ROLL_180
define HAL_DEFAULT_INS_FAST_SAMPLE 1
PE9 IMU_CLKIN INPUT FLOATING
PE13 EXT_IMU_CLK INPUT FLOATING

PE2 SPI4_SCK SPI4
PE5 SPI4_MISO SPI4
PE6 SPI4_MOSI SPI4
PE3 EXT_IMU_CS CS
PE4 EXT_IMU_INT INPUT FLOATING
SPIDEV icm45686_ext SPI4 DEVID2 EXT_IMU_CS MODE3 2*MHZ 8*MHZ
IMU Invensensev3 SPI:icm45686_ext ROTATION_ROLL_180

I2C_ORDER I2C2 I2C3 I2C4
PB10 I2C2_SCL I2C2
PB11 I2C2_SDA I2C2
PA8 I2C3_SCL I2C3
PC9 I2C3_SDA I2C3
PD12 I2C4_SCL I2C4
PD13 I2C4_SDA I2C4
define HAL_I2C_INTERNAL_MASK 1
define HAL_I2C_MAX_CLOCK 400000
BARO BMP581 I2C:0:0x46
COMPASS MMC5XX3 I2C:0:0x30 false ROTATION_ROLL_180

PC5 AI1 ADC1 SCALE(1)
PC4 AI2 ADC1 SCALE(1)
define HAL_BATT_MONITOR_DEFAULT 4
define HAL_BATTMON_INA2XX_BUS 2
define HAL_BATTMON_INA2XX_ADDR 69
define DEFAULT_BATTMON_INA2XX_SHUNT 0.0005
define DEFAULT_BATTMON_INA2XX_MAX_AMPS 120
define HAL_BATT_VOLT_PIN 8
define HAL_BATT_VOLT_SCALE 11
define HAL_BATT_CURR_PIN 4
define HAL_BATT_CURR_SCALE 50

PB9 CAN1_TX CAN1
PB8 CAN1_RX CAN1
PB6 CAN2_TX CAN2
PB5 CAN2_RX CAN2

PB14 SDMMC2_D0 SDMMC2
PB15 SDMMC2_D1 SDMMC2
PB3 SDMMC2_D2 SDMMC2
PB4 SDMMC2_D3 SDMMC2
PD6 SDMMC2_CK SDMMC2
PD7 SDMMC2_CMD SDMMC2
define FATFS_HAL_DEVICE SDCD2
define HAL_OS_FATFS_IO 1
define HAL_LOGGER_MIN_MB_FREE 16

PA0 TIM2_CH1 TIM2 PWM(1) GPIO(50) BIDIR
PA1 TIM2_CH2 TIM2 PWM(2) GPIO(51)
PA2 TIM2_CH3 TIM2 PWM(3) GPIO(52) BIDIR
PA3 TIM2_CH4 TIM2 PWM(4) GPIO(53)
PB1 TIM3_CH4 TIM3 PWM(5) GPIO(54)
PB0 TIM3_CH3 TIM3 PWM(6) GPIO(55) BIDIR
PD14 TIM4_CH3 TIM4 PWM(7) GPIO(56) BIDIR
PD15 TIM4_CH4 TIM4 PWM(8) GPIO(57)
PB7 TIM17_CH1N TIM17 PWM(9) GPIO(58)
define AP_NOTIFY_NEOPIXEL_MASK 256
define DEFAULT_NTF_LED_TYPES 256
define HAL_SERIALLED_RESET_US 300
DMA_NOSHARE SPI1* TIM17*
DMA_PRIORITY SPI1* TIM17* TIM2* TIM3* TIM4*

define HAL_BOARD_INIT_HOOK_CALL RCC->APB4ENR |= RCC_APB4ENR_SYSCFGEN; (void)RCC->APB4ENR; SYSCFG->PMCR &= ~SYSCFG_PMCR_PC3SO; palSetLineMode(PAL_LINE(GPIOE,0U),PAL_MODE_INPUT_ANALOG); palSetLineMode(PAL_LINE(GPIOE,1U),PAL_MODE_INPUT_ANALOG); palSetLineMode(PAL_LINE(GPIOD,8U),PAL_MODE_INPUT_ANALOG); palSetLineMode(PAL_LINE(GPIOD,9U),PAL_MODE_INPUT_ANALOG); palSetLineMode(PAL_LINE(GPIOD,12U),PAL_MODE_INPUT_ANALOG); palSetLineMode(PAL_LINE(GPIOD,13U),PAL_MODE_INPUT_ANALOG); palSetLineMode(PAL_LINE(GPIOC,4U),PAL_MODE_INPUT_ANALOG); palSetLineMode(PAL_LINE(GPIOC,5U),PAL_MODE_INPUT_ANALOG); palSetLineMode(PAL_LINE(GPIOE,9U),PAL_MODE_INPUT_ANALOG); palSetLineMode(PAL_LINE(GPIOE,13U),PAL_MODE_INPUT_ANALOG);
