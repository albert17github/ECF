# ECFH743 complete shared-pad profile; 3.3V logic only.
resource SERIAL_TX 8 E01
resource SERIAL_RX 8 E00
serial UART8 0 115200 57600 0 115200
resource ADC_BATT 1 NONE
resource ADC_CURR 1 NONE
set battery_meter = NONE
set current_meter = NONE
set vbat_scale = 110
set vbat_divider = 10
set vbat_multiplier = 1
set ibata_scale = 200
set ibata_offset = 0
resource SERIAL_TX 3 D08
resource SERIAL_RX 3 D09
serial UART3 0 115200 57600 0 115200
resource I2C_SCL 4 NONE
resource I2C_SDA 4 NONE
set i2c4_clockspeed_khz = 400
save
